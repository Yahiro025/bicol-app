# ─────────────────────────────────────────────────────────────────────
# BIKOL Dictionary — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# Database (PostgreSQL on Supabase)
# Used by: lib/prisma.ts, prisma.config.ts — required for all API routes that read/write data
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Groq AI SDK key
# Used by: lib/groq.ts — consumed by /api/learn (quiz generation) and /api/learn/dialogue (dialogue processing)
GROQ_API_KEY="gsk_your-groq-api-key"

# Google Generative AI (Gemini) SDK key
# Used by: lib/gemini.ts — consumed by /api/drills (substitution drill generation)
GEMINI_API_KEY="your-gemini-api-key"

# Admin Authentication — HMAC-based (no third-party auth provider)
# Used by: lib/admin-auth.ts — consumed by /api/admin/session, /api/admin/word-original, /api/submit
# ADMIN_PASSWORD must be >= 12 characters
ADMIN_PASSWORD="replace-with-a-long-admin-password"
# ADMIN_SESSION_SECRET must be >= 32 characters
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters!!"

# Canonical site URL for SEO metadata and sitemap generation
# Used by: app/layout.tsx, app/robots.ts, app/sitemap.ts, components/WordJsonLd.tsx
NEXT_PUBLIC_SITE_URL="https://your-domain.example.com"

# Build mode — set to "mobile" only for Capacitor static export builds
# Used by: next.config.mjs — controls output mode (static export vs server)
# NEXT_PUBLIC_PLATFORM="mobile"
